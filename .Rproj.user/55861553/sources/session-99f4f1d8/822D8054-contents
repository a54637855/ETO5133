table<-data.frame(Variable=c("Group","Year","Other Fruits","Apples,Bananas and Oranges","Citrus Fruits"),Description=c("Geographic Group","Year, 1973-2023","Other fruits not listed, excluding Dates,Pineapples,Plantains and Grapes","Apples, Bananas and Oranges","Citrus, including Grapefruits, Lemons, Limes and other citrus fruits"))
